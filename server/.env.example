NODE_ENV=development
PORT=4000

# MongoDB Atlas (free tier) or local:  mongodb://127.0.0.1:27017/smart_tourist_safety
MONGODB_URI=mongodb://127.0.0.1:27017/smart_tourist_safety

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of frontend origins allowed to call the API / open sockets
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind one reverse proxy / load balancer (Render, Railway, nginx...)
TRUST_PROXY=0

LOG_LEVEL=info

# Safety rules
CHECKIN_INTERVAL_HOURS=12
STALE_LOCATION_MINUTES=30
LOCATION_RETENTION_DAYS=30
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Optional: secret used to hash identity-document numbers (defaults to JWT_REFRESH_SECRET). Set once; changing it invalidates stored hashes.
# PROOF_SALT=
